{
  "schema_version": 2,
  "status": "active",
  "owners": [
    "host",
    "test-git",
    "test-git-tests"
  ],
  "projects": [
    {
      "id": "test-git",
      "kind": "production",
      "manifest": "crates/test-git/Cargo.toml",
      "lockfile": "crates/test-git/Cargo.lock",
      "root": "crates/test-git",
      "test_project": "test-git-tests",
      "actions": {
        "verify_commands": {
          "operation": "verify.test-git-commands",
          "tool": "verus",
          "argv": [
            "--crate-type=lib",
            "--no-cheating",
            "--no-external-by-default",
            "--num-threads",
            "2",
            "--output-json",
            "--compile",
            "--emit=link=.chrono-harness/state/verify.test-git-commands.rlib,dep-info=.chrono-harness/state/verify.test-git-commands.rlib.d",
            "crates/test-git/src/lib.rs",
            "-o",
            ".chrono-harness/state/verify.test-git-commands.rlib",
            "-Zchecksum-hash-algorithm=sha256"
          ],
          "output_contract": {
            "version": "0.2026.04.24.f8e1704",
            "commit": "f8e17045c4ac17a02e566b8997070f2eecc255be"
          }
        },
        "verify_profile_failures": {
          "operation": "verify.test-git-profile-failures",
          "tool": "verus",
          "argv": [
            "--crate-type=lib",
            "--no-cheating",
            "--no-external-by-default",
            "--num-threads",
            "2",
            "--output-json",
            "--compile",
            "--emit=link=.chrono-harness/state/verify.test-git-profile-failures.rlib,dep-info=.chrono-harness/state/verify.test-git-profile-failures.rlib.d",
            "crates/test-git/src/profile_failure.rs",
            "-o",
            ".chrono-harness/state/verify.test-git-profile-failures.rlib",
            "-Zchecksum-hash-algorithm=sha256"
          ],
          "output_contract": {
            "version": "0.2026.04.24.f8e1704",
            "commit": "f8e17045c4ac17a02e566b8997070f2eecc255be"
          }
        }
      },
      "language": "rust"
    },
    {
      "id": "test-git-tests",
      "kind": "test",
      "manifest": "crates/test-git-tests/Cargo.toml",
      "lockfile": "crates/test-git-tests/Cargo.lock",
      "root": "crates/test-git-tests",
      "tests_for": "test-git",
      "actions": {
        "verify_commands_tests": {
          "operation": "verify.test-git-commands-tests",
          "tool": "verus",
          "argv": [
            "--crate-type=lib",
            "--no-cheating",
            "--no-external-by-default",
            "--num-threads",
            "2",
            "--output-json",
            "--compile",
            "--emit=link=.chrono-harness/state/verify.test-git-commands-tests.rlib,dep-info=.chrono-harness/state/verify.test-git-commands-tests.rlib.d",
            "crates/test-git-tests/tests/commands.rs",
            "-o",
            ".chrono-harness/state/verify.test-git-commands-tests.rlib",
            "-Zchecksum-hash-algorithm=sha256"
          ],
          "output_contract": {
            "version": "0.2026.04.24.f8e1704",
            "commit": "f8e17045c4ac17a02e566b8997070f2eecc255be"
          }
        },
        "execute": {
          "operation": "test-git.owner-check",
          "tool": "bash",
          "argv": [
            "./check.sh",
            "--native"
          ]
        },
        "verify_profile_failures": {
          "operation": "verify.test-git-profile-failures-tests",
          "tool": "verus",
          "argv": [
            "--crate-type=lib",
            "--no-cheating",
            "--no-external-by-default",
            "--num-threads",
            "2",
            "--output-json",
            "--compile",
            "--emit=link=.chrono-harness/state/verify.test-git-profile-failures-tests.rlib,dep-info=.chrono-harness/state/verify.test-git-profile-failures-tests.rlib.d",
            "crates/test-git-tests/tests/profile_failures.rs",
            "-o",
            ".chrono-harness/state/verify.test-git-profile-failures-tests.rlib",
            "-Zchecksum-hash-algorithm=sha256"
          ],
          "output_contract": {
            "version": "0.2026.04.24.f8e1704",
            "commit": "f8e17045c4ac17a02e566b8997070f2eecc255be"
          }
        }
      },
      "language": "rust"
    }
  ],
  "scripts": []
}
